{
  "name": "@trien/contract",
  "version": "0.1.0",
  "description": "Compact contract for Triện: anonymous, revocable allowlist access on Midnight",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./managed": {
      "types": "./src/managed/trien/contract/index.d.ts",
      "default": "./src/managed/trien/contract/index.js"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "compact": "compact compile src/trien.compact src/managed/trien",
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
