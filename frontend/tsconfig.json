{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    // "node" is for vite.config.ts, which reads process.env and runs in Node
    // rather than the browser. It typechecked locally without this only
    // because @types/node was hoisted out of the contract dependency; a clean
    // install has no such accident, and CI caught it.
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}
